# Copy to .env and fill in whatever you have. Every value is optional.
#
# With no keys at all the system still runs end to end: Google News RSS and
# Wikipedia answer queries with no credential, the bundled ONNX model
# deduplicates evidence, and a local Ollama or LM Studio can drive the agents.
# Add one free tier LLM key (Gemini, Groq and Cloudflare all have one) and the
# whole agent team works without spending anything.

# ---------------------------------------------------------------- essentials

APP_NAME=Multi-Agentic
# Set this on a hosted deployment so generated links are absolute.
PUBLIC_BASE_URL=

# Storage. Leave DATABASE_URL empty to use SQLite on the local filesystem.
# A long running agent needs a durable filesystem or a Postgres URL: a run's
# checkpoints are what make it resumable, and losing them loses the run.
DATABASE_URL=
DATA_DIR=./data

# Optional password on the whole API, sent by the browser as X-App-Password.
APP_PASSWORD=

# Let visitors paste their own provider keys in the UI. On, a public
# deployment costs you nothing because each visitor spends their own quota.
ALLOW_CLIENT_KEYS=1

# Browser origins allowed to call the API, comma separated. Empty means the
# Next.js dev origins only.
CORS_ORIGINS=

# ------------------------------------------------------------- LLM providers
# You need at most one. Gemini, Groq, Cerebras and Cloudflare all have a usable
# free tier. Running locally, Ollama needs no key at all.

GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
HUGGINGFACE_API_KEY=

# Cloudflare Workers AI needs BOTH values: the account id is part of the URL,
# so a token on its own cannot address anything.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local model servers. Only reachable when the app runs on your own machine or
# a VM, never from a serverless deployment.
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
VLLM_BASE_URL=http://localhost:8000/v1

# Pin a model per provider, otherwise the picker's default is used.
GEMINI_MODEL=
GROQ_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
CLOUDFLARE_MODEL=
HUGGINGFACE_MODEL=

# Which provider and model a run uses when the caller names neither. Empty
# means the first available provider in the registry's order.
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# ---------------------------------------------------------------- embeddings
# "auto" picks the best available backend, which on a fresh install is the
# bundled ONNX model and needs no key. Named options: onnx, gemini_embed,
# cloudflare_embed, jina_embed, voyage_embed, openai_embed, cohere_embed,
# sentence_transformers, ollama_embed, hf_embed, lexical.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LOCAL_EMBED_ENABLED=1

JINA_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# ------------------------------------------------------------ research tools
# Web search backends the Researcher agent can call. All optional: with none of
# them set it falls back to Google News RSS and Wikipedia, which need no key.

SERPAPI_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SEARXNG_BASE_URL=

# Keyless breadth. Turn off only to measure what the paid backends contribute.
ENABLE_KEYLESS_SEARCH=1

# -------------------------------------------------------------- web access

# Identify yourself honestly. Put a real contact in here on a public deployment.
USER_AGENT=MultiAgenticBot/1.0 (+https://example.com/about; autonomous research agent)
# Turning this off means ignoring sites that asked not to be crawled. Only do
# that for sites you have permission to read.
RESPECT_ROBOTS=1
PER_HOST_DELAY=1.0
FETCH_TIMEOUT=20
FETCH_CONCURRENCY=8

# ------------------------------------------------------------- agent budgets
# Every ceiling below PAUSES the run rather than killing it. A paused run keeps
# all its work, so the recovery is to raise the cap and resume, not to restart.
# These are the single most important settings if you are watching your spend.

# Stop after this many orchestrator steps.
MAX_RUN_STEPS=120
# Stop after this many tokens across every agent in the run.
MAX_RUN_TOKENS=400000
# Stop once the estimated bill reaches this many US dollars. Free tier models
# are priced at zero, so this ceiling only ever binds on a paid provider.
MAX_RUN_USD=0.50
# Wall clock ceiling for one run, in seconds.
MAX_RUN_SECONDS=1800
# Stop after this many tool invocations.
MAX_TOOL_CALLS=80

# How many reason and act iterations a single agent may spend before the
# kernel cuts it off and takes what it has.
MAX_AGENT_ITERATIONS=8

# How many researchers work at once. Free tiers are rate limited per minute, so
# a small number finishes sooner than a large one.
AGENT_CONCURRENCY=3

# How many times the Critic may send a draft back to the Writer.
MAX_REVISIONS=2
# How many times the Supervisor may send the researchers back out. Each round
# is a full plan, research, analyse and verify cycle, so this is the biggest
# single multiplier on what a run costs. 1 disables the research loop.
MAX_RESEARCH_ROUNDS=2
# The Critic's pass mark out of 100.
QUALITY_BAR=75
# Independent domains a claim needs before it counts as corroborated.
CORROBORATION_MIN=2

# Write a checkpoint after every step. Off makes a run slightly faster and
# completely unresumable, which is only sensible in a throwaway benchmark.
CHECKPOINT_EVERY_STEP=1
# Seconds between control channel polls. This is the worst case delay between
# pressing pause and the run actually stopping.
CONTROL_POLL_SECONDS=1.0

# --------------------------------------------------------------- behaviour

DEFAULT_TIMEZONE=Asia/Kolkata
DEBUG=0

# Force a runtime tier instead of detecting it. Almost never needed.
# RUNTIME_TIER=server
